# Frontend (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# PWA Web Push (public key only; generate pair with: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=

# Borrower install gate: unset = on in production only; "false" = off; "true" = always on
# VITE_BORROWER_WEB_INSTALL_GATE=false

# API strangler (optional; apps/api-next defaults to port 3001)
# VITE_API_URL=http://localhost:3001
# VITE_API_LOAN_PRODUCTS=false
#
# Borrower payment claims & workflow (read before go-live):
# - VITE_API_PHASE1_WORKFLOW=true → payment claims POST /api/v1/repayments/:id/payment-claims (needs running api-next + VITE_API_URL).
# - VITE_API_PHASE1_WORKFLOW=false → borrower claims insert directly into Supabase payment_claims (same statuses; use pending_review).
# Mismatch here causes "Submit payment" errors that look like app bugs.
# VITE_API_PHASE1_WORKFLOW=false
# VITE_DEV_SUPPORT_WHATSAPP=https://wa.me/2609XXXXXXXX?text=Hello%20Developer%2C%20I%20need%20help%20on%20admin%20dashboard.

# Beta UI: comma-separated keys show Beta badges on matching admin nav/features
# Example: loans_by_product,product_dashboards,marketeer
# VITE_BETA_MODULES=loans_by_product,product_dashboards,marketeer
