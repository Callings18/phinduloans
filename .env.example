# Frontend (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# PWA Web Push (public key only; generate pair with: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=

# Borrower install: hard wall DISABLED (web-first). Soft APK/PWA nudge only on app.phindu.com after login.
# Place APK at apps/borrower-mobile/public/downloads/PhinduCredit.apk → /downloads/PhinduCredit.apk
# VITE_BORROWER_WEB_INSTALL_GATE is ignored (always off).
# Borrower app URL used by marketing/staff redirects (always absolute)
# VITE_BORROWER_APP_URL=https://app.phindu.com
# Staff-web: three Cloudflare builds share one Lovable Cloud DB
#   phindu.com        → VITE_SITE_MODE=marketing  (no AI; Login → app)
#   office.phindu.com → VITE_SITE_MODE=office     (staff Auth + admin only)
#   app.phindu.com    → borrower-mobile build
# VITE_SITE_MODE=marketing
# Office domain for admin redirects when running in marketing mode
# VITE_OFFICE_BASE_URL=https://office.phindu.com
# Optional marketing origin (hostname guards)
# VITE_MARKETING_BASE_URL=https://phindu.com

# Edge function SMS (ExciteSMS only — set these in Lovable/Supabase secrets)
# EXCITESMS_API_TOKEN=
# EXCITESMS_API_URL=https://gateway.excitesms.com/api/v3
# EXCITESMS_SENDER_ID=Phindu
# BORROWER_APP_URL=https://app.phindu.com
# After OTP changes: redeploy verify-otp so borrowers land on app.phindu.com/dashboard (not phindu.com)
# Optional secondary ExciteSMS token for OTP resends:
# EXCITESMS_SECONDARY_API_TOKEN=
# API strangler — set this to the Railway Nest URL in production (enables apply, add-borrower, record payment).
# VITE_API_URL=http://localhost:3000
# VITE_API_LOAN_PRODUCTS=true
# VITE_API_CORE_WRITES=true
# VITE_API_PHASE1_WORKFLOW=true
#
# Borrower payment claims & workflow (read before go-live):
# - VITE_API_PHASE1_WORKFLOW=true → Nest POST /api/v1/repayments/:id/payment-claims (needs running backend + VITE_API_URL).
# - VITE_API_PHASE1_WORKFLOW=false → borrower claims insert directly into Supabase payment_claims (same statuses; use pending_review).
# Mismatch here causes "Submit payment" errors that look like app bugs.
# VITE_API_PHASE1_WORKFLOW=false
# VITE_DEV_SUPPORT_WHATSAPP=https://wa.me/2609XXXXXXXX?text=Hello%20Developer%2C%20I%20need%20help%20on%20admin%20dashboard.

# Beta UI: comma-separated keys show Beta badges on matching admin nav/features
# Example: loans_by_product,product_dashboards,marketeer
# VITE_BETA_MODULES=loans_by_product,product_dashboards,marketeer
