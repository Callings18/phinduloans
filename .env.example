# Frontend (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# PWA Web Push (public key only; generate pair with: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=

# Borrower install gate: unset = on in production only; "false" = off; "true" = always on
# VITE_BORROWER_WEB_INSTALL_GATE=false

# API strangler (optional; apps/api-next defaults to port 3001)
# VITE_API_URL=http://localhost:3001
# VITE_API_LOAN_PRODUCTS=false
# When true, loan transitions and payment claims use apps/api-next (Bearer session).
# VITE_API_PHASE1_WORKFLOW=false
# VITE_DEV_SUPPORT_WHATSAPP=https://wa.me/2609XXXXXXXX?text=Hello%20Developer%2C%20I%20need%20help%20on%20admin%20dashboard.
