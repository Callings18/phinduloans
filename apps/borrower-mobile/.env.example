# Borrower PWA (app.phindu.com) — copy to apps/borrower-mobile/.env for local dev

# Required
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Canonical URLs (production defaults work if unset)
# VITE_BORROWER_APP_URL=https://app.phindu.com
# VITE_OFFICE_BASE_URL=https://office.phindu.com

# Keep Supabase paths for borrower flows unless API is deployed:
# VITE_API_PHASE1_WORKFLOW=false   ← payment claims insert directly to Supabase
# VITE_API_LOAN_PRODUCTS=false     ← loan products from Supabase (or true + VITE_API_URL)
# VITE_API_URL=https://your-api.example.com

# Google OAuth (borrower) — show "Continue with Google" only when true.
# Prerequisites in Supabase Dashboard → Authentication → Providers → Google:
#   - Google Cloud OAuth client (Web) with authorized redirect:
#     https://<project-ref>.supabase.co/auth/v1/callback
#   - Supabase redirect URLs must include:
#     https://app.phindu.com/auth
#     http://localhost:8081/auth
# VITE_BORROWER_GOOGLE_OAUTH_ENABLED=true

# Optional
# VITE_SENTRY_DSN=
# VITE_VAPID_PUBLIC_KEY=
# VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.phindu.loans.borrower
