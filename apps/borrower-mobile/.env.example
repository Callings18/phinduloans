# Borrower PWA (app.phindu.com) — copy to apps/borrower-mobile/.env for local dev

# Required
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Canonical URLs (production defaults work if unset)
# VITE_BORROWER_APP_URL=https://app.phindu.com
# VITE_OFFICE_BASE_URL=https://office.phindu.com

# Keep Supabase paths for borrower flows unless API is deployed:
# VITE_API_PHASE1_WORKFLOW=false   ← payment claims insert directly to Supabase
# VITE_API_LOAN_PRODUCTS=false     ← loan products from Supabase (or true + VITE_API_URL)
# VITE_API_URL=https://your-api.example.com

# Optional
# VITE_SENTRY_DSN=
# VITE_VAPID_PUBLIC_KEY=
