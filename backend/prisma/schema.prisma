// Mirrors `public.loan_products` (see src/integrations/supabase/types.ts).
// If introspecting an existing DB: `npx prisma db pull` then `npx prisma generate`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LoanProduct {
  id                           String    @id @db.Uuid
  amount_logic                 String?
  auto_disbursement            Boolean?
  blacklist_check_required     Boolean?
  channels                     String[]
  collateral_required          Boolean?
  contract_template_url        String?
  crb_auto_approve_score       Decimal?  @db.Decimal(18, 4)
  crb_auto_decline_score       Decimal?  @db.Decimal(18, 4)
  crb_check_required           Boolean?
  crb_manual_review_score      Decimal?  @db.Decimal(18, 4)
  created_at                   DateTime  @default(now()) @db.Timestamptz(6)
  default_threshold_days       Int?
  description                  String?
  digital_signature_required     Boolean?
  early_repayment_allowed      Boolean?
  early_repayment_fee_percent  Decimal?  @db.Decimal(18, 4)
  eligible_locations           String[]
  employer_whitelist_enabled   Boolean?
  employment_types             String[]
  enforcement_fee_percent      Decimal?  @db.Decimal(18, 4)
  flat_interest_mode           String?
  grace_period_days            Int?
  guarantee_fee_percent        Decimal?  @db.Decimal(18, 4)
  guarantee_provider           String?
  guarantee_required           Boolean?
  installment_structure        String?
  insurance_percent            Decimal?  @db.Decimal(18, 4)
  insurance_required           Boolean?
  interest_period              String?
  interest_rate                Decimal   @db.Decimal(18, 4)
  interest_type                String?
  is_active                    Boolean?
  late_payment_penalty_percent Decimal?  @db.Decimal(18, 4)
  legal_escalation_days        Int?
  max_age                      Int?
  max_amount                   Decimal   @db.Decimal(18, 4)
  max_concurrent_loans         Int?
  max_dti_ratio                Decimal?  @db.Decimal(18, 4)
  max_guarantee_percent        Decimal?  @db.Decimal(18, 4)
  max_salary_percent           Decimal?  @db.Decimal(18, 4)
  max_term_months              Int
  min_age                      Int?
  min_amount                   Decimal   @db.Decimal(18, 4)
  min_credit_score             Int?
  min_salary                   Decimal?  @db.Decimal(18, 4)
  min_term_months              Int
  mou_required                 Boolean?
  name                         String
  parent_product_id            String?   @db.Uuid
  partial_disbursement         Boolean?
  penalty_frequency            String?
  platform_fee_percent         Decimal?  @db.Decimal(18, 4)
  platform_fee_type            String?
  processing_fee_percent       Decimal?  @db.Decimal(18, 4)
  product_code                 String?
  repayment_frequency          String?
  repayment_methods            String[]
  required_documents           Json?
  requirements                 String[]
  status                       String?
  term_unit                    String
  updated_at                   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  vat_percent                  Decimal?  @db.Decimal(18, 4)
  version                      Int?

  @@map("loan_products")
}

/// Subset of `loan_applications` used by the Nest write API (existing Supabase table).
model LoanApplication {
  id          String    @id @db.Uuid
  user_id     String    @db.Uuid
  status      String
  reviewed_by String?   @db.Uuid
  reviewed_at DateTime? @db.Timestamptz(6)

  @@map("loan_applications")
}

model LoanStatusTransition {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loan_id     String   @db.Uuid
  from_status String
  to_status   String
  actor_type  String
  actor_id    String?  @db.Uuid
  reason_code String?
  reason_text String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@map("loan_status_transitions")
}

model LoanEvent {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loan_id          String   @db.Uuid
  event_type       String
  performed_by     String?  @db.Uuid
  reason           String?
  previous_values  Json?
  new_values       Json?
  visibility       String?  @default("both")
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  performed_at     DateTime @default(now()) @db.Timestamptz(6)

  @@map("loan_events")
}

model UserRole {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  role       String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("user_roles")
}

model NotificationLog {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String?  @db.Uuid
  title              String?
  message            String?
  type               String
  status             String?
  recipient          String
  provider_response  Json?
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  @@map("notification_logs")
}

model LoanRepayment {
  id               String   @id @db.Uuid
  loan_id          String   @db.Uuid
  user_id          String   @db.Uuid
  amount           Decimal  @db.Decimal(18, 4)
  original_amount  Decimal? @db.Decimal(18, 4)
  principal_paid   Decimal? @db.Decimal(18, 4)
  status           String?

  @@map("loan_repayments")
}

model PaymentClaim {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loan_id               String    @db.Uuid
  repayment_id          String    @db.Uuid
  user_id               String    @db.Uuid
  amount                Decimal   @db.Decimal(18, 4)
  reference             String
  receipt_url           String?
  status                String    @default("pending")
  review_comment        String?
  decision_reason_code  String?
  verified_at           DateTime? @db.Timestamptz(6)
  verified_by           String?   @db.Uuid
  created_at            DateTime  @default(now()) @db.Timestamptz(6)

  @@map("payment_claims")
}
